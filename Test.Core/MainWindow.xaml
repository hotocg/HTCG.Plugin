<Window x:Class="Test.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test.Core"
        xmlns:p="http://schemas.htcgplugin/2025/xaml"
        mc:Ignorable="d"
        Title="Test Core" Width="400" Height="400"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Button Content="Test"
                    p:CommandBehavior.Event="Click"
                    p:CommandBehavior.Command="{Binding TestCommand}"
                    p:CommandBehavior.CommandParameter="Hello World"
                    />

            <UniformGrid Rows="1">
                <Button Content="Async Test"
                        Command="{Binding AsyncTestCommand}"
                        CommandParameter="{Binding}"
                        />
                <CheckBox IsChecked="{Binding CanExecute}" Content="CanExecute"/>
            </UniformGrid>
        </StackPanel>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="TextLength: "/>
                <TextBlock Text="{Binding TextLength}"/>
            </StackPanel>
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Text}"/>
        </DockPanel>
    </Grid>
</Window>
